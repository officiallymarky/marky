#!/bin/sh
# Runs before `git push`, scanning the current working tree.
# This does not scan outgoing history: a secret committed and later removed
# can pass this check.
#
# Installed by `just install-hooks` (hooks are not versioned). A missing scanner
# fails the push rather than silently skipping the working-tree scan.
#
# The scan reads the working tree, and betterleaks does not honour .gitignore, so
# a secret sitting in an ignored local file also blocks the push. That is the
# intended reading here: a secret in the tree is worth knowing about before
# anything leaves the machine. `git push --no-verify` skips the hook.
set -e
if ! command -v betterleaks >/dev/null 2>&1; then
    echo "secret scan cannot run: betterleaks is not installed" >&2
    exit 1
fi
exec just secrets
